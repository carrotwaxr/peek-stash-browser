# syntax=docker/dockerfile:1
# Production image: nginx, the Node server and SQLite in one container.
# Platform-independent work (the Vite build, tsc) runs on the build platform;
# only the production dependencies and the Prisma engines are per target.

# ===========================
# Package manifests without the release version. The release bump edits
# client/package.json and server/package.json; stripped of it, the manifests
# (and so every npm ci layer below) change only when dependencies do.
# ===========================
FROM --platform=$BUILDPLATFORM node:22-slim AS manifests
WORKDIR /m
COPY client/package.json client/package-lock.json ./client/
COPY server/package.json server/package-lock.json ./server/
COPY shared/package.json shared/package-lock.json ./shared/
RUN node -e 'const fs = require("fs"); \
  for (const dir of ["client", "server", "shared"]) { \
    for (const file of ["package.json", "package-lock.json"]) { \
      const path = `${dir}/${file}`; \
      const json = JSON.parse(fs.readFileSync(path, "utf8")); \
      delete json.version; \
      if (json.packages && json.packages[""]) delete json.packages[""].version; \
      fs.writeFileSync(path, JSON.stringify(json, null, 2) + "\n"); \
    } \
  }'

# ===========================
# Frontend: static files, built once on the build platform
# ===========================
FROM --platform=$BUILDPLATFORM node:22-slim AS frontend-build
WORKDIR /app/client
COPY --from=manifests /m/shared/package.json /app/shared/
COPY --from=manifests /m/client/ ./
RUN npm ci --no-audit
COPY shared/tsconfig.json /app/shared/
COPY shared/types /app/shared/types
# The real package.json (with the version the settings page shows) comes back here
COPY client/ ./
RUN npm run build

# ===========================
# Server and shared types: tsc output is platform-independent
# ===========================
FROM --platform=$BUILDPLATFORM node:22-slim AS server-build
WORKDIR /app/shared
COPY --from=manifests /m/shared/ ./
RUN npm ci --no-audit
WORKDIR /app/server
COPY --from=manifests /m/server/ ./
RUN npm ci --no-audit
# The generated client's types, for tsc; the runtime client comes from server-deps
COPY server/prisma/schema.prisma ./prisma/
RUN npx prisma generate
COPY shared/ /app/shared/
RUN cd /app/shared && rm -f tsconfig.tsbuildinfo && npm run build
COPY server/ ./
RUN npm run build && rm -f dist/vitest.config.js

# ===========================
# Runtime base: the system packages, one apt step per platform. Per-platform
# cache ids stop a two-platform build from queueing on one apt lock.
# ===========================
FROM node:22-slim AS runtime-base
ARG TARGETARCH
RUN --mount=type=cache,id=apt-cache-$TARGETARCH,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,id=apt-lib-$TARGETARCH,target=/var/lib/apt,sharing=locked \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        nginx \
        sqlite3 \
        ca-certificates \
        curl \
    && rm -f /etc/nginx/sites-enabled/default

# ===========================
# Production node_modules for the target platform. Prisma picks its engines by
# the OpenSSL it finds at install time: ca-certificates brings the openssl
# package, so it finds 3.0.x, as the runtime needs (CI-10). No dependency
# compiles native code, so no C toolchain. prisma (the CLI, for runtime
# migrations) stays: it is a peer of @prisma/client. typescript is an
# optional peer, not needed at runtime. The @peek/shared-types link would
# point at /shared in the runtime stage; the built package replaces it (CI-9).
# ===========================
FROM runtime-base AS server-deps
WORKDIR /app/server
COPY --from=manifests /m/shared/package.json /app/shared/
COPY --from=manifests /m/server/ ./
RUN npm ci --omit=dev --no-audit && \
    rm -rf node_modules/typescript node_modules/@peek/shared-types
COPY server/prisma/schema.prisma ./prisma/
RUN npx prisma generate

# ===========================
# Runtime
# ===========================
FROM runtime-base AS production

# App user, created as 99:100 (unRAID nobody:users, the PUID/PGID defaults).
# docker/entrypoint.sh remaps it when PUID/PGID differ.
RUN userdel --remove node \
    && groupadd --non-unique --gid 100 peek \
    && useradd --system --uid 99 --gid 100 --home-dir /home/peek --create-home --shell /usr/sbin/nologin peek

WORKDIR /app

# Largest and least-changing first: this layer is reused across releases
# whose lockfiles and Prisma schema are unchanged
COPY --from=server-deps /app/server/node_modules ./node_modules
# The shared types as a real package directory (package.json and dist only)
COPY --from=server-build /app/shared/package.json ./node_modules/@peek/shared-types/package.json
COPY --from=server-build /app/shared/dist ./node_modules/@peek/shared-types/dist

# Prisma schema and migrations (for runtime migrations)
COPY server/prisma/schema.prisma ./prisma/
COPY server/prisma/migrations ./prisma/migrations

COPY --from=server-build /app/server/dist ./backend/
COPY --from=frontend-build /app/client/dist ./frontend/

# nginx main config, entrypoint (root: maps the user, starts nginx) and start script (app user)
COPY docker/nginx.conf /etc/nginx/nginx.conf
COPY --chmod=0755 docker/entrypoint.sh docker/start.sh /app/

# The version utils/serverVersion.ts reads. Last among the files, because
# every release changes it
COPY server/package.json ./

# Check the nginx config, then create the data directory owned by the app user
RUN mkdir -p /tmp/nginx && nginx -t -e stderr -g "user peek peek;" && rm -rf /tmp/nginx \
    && mkdir -p /app/data/tmp && chown -R peek:peek /app/data

# Expose port 80
EXPOSE 80

# Set environment variables. CHECKPOINT_DISABLE stops the Prisma CLI's update
# check from writing to $HOME/.cache.
ENV DATABASE_URL="file:/app/data/peek-stash-browser.db" \
    NODE_ENV="production" \
    NODE_OPTIONS="--max-old-space-size=2048" \
    PUID=99 \
    PGID=100 \
    CHECKPOINT_DISABLE=1 \
    NPM_CONFIG_UPDATE_NOTIFIER=false

# Health check: proves Node answers through nginx (no database query)
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -fsS --max-time 8 http://127.0.0.1/api/health > /dev/null || exit 1

# Create volumes for persistence
VOLUME ["/app/data"]

# No USER line: the entrypoint needs root to map PUID/PGID and start nginx,
# then runs start.sh as the app user
ENTRYPOINT ["/app/entrypoint.sh"]
CMD ["/app/start.sh"]

# Last, so a new date invalidates no earlier layer
ARG BUILD_DATE
ENV BUILD_DATE=${BUILD_DATE}
