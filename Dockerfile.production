# syntax=docker/dockerfile:1
# Production Single Container Dockerfile
# Combines frontend and backend with SQLite database
# Optimized for size and build performance

# ===========================
# Stage 1: Frontend Build
# ===========================
FROM --platform=$BUILDPLATFORM node:22-slim AS frontend-build

WORKDIR /app

# Copy shared types package (needed for file: dependency and vite alias)
COPY shared/package.json shared/tsconfig.json ./shared/
COPY shared/types ./shared/types

WORKDIR /app/client

# Copy package files first for better layer caching
COPY client/package*.json ./

# Use npm ci for reproducible builds
RUN npm ci --no-audit --prefer-offline

# Copy source and build
COPY client/ ./
RUN npm run build

# ===========================
# Stage 2: Backend Build
# ===========================
FROM node:22-slim AS backend-build

# Build shared type declarations first
WORKDIR /app/shared
COPY shared/package*.json ./
RUN npm ci --no-audit --prefer-offline
COPY shared/ ./
RUN rm -f tsconfig.tsbuildinfo && npm run build

WORKDIR /app/server

# Prisma picks its engine by the OpenSSL it finds at install time; without the
# openssl CLI it guesses 1.1.x and the runtime stage (OpenSSL 3) cannot start.
# No dependency compiles native code, so no C toolchain.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && \
    apt-get install -y --no-install-recommends openssl

# Copy package files first for better layer caching
COPY server/package*.json ./

# Install all dependencies (including dev) for build
RUN npm ci --no-audit --prefer-offline

# Copy Prisma schema and generate client
COPY server/prisma ./prisma
RUN npx prisma generate

# Copy source and build (remove test config from dist)
COPY server/ ./
RUN npm run build && rm -f dist/vitest.config.js

# Prune dev dependencies for production. Keep the prisma CLI for runtime
# migrations; drop typescript (a peer dependency). npm links @peek/shared-types
# to ../shared, a link that would point at /shared in the runtime stage:
# replace it with the built package (package.json and dist only).
RUN npm prune --omit=dev && \
    rm -rf node_modules/typescript node_modules/@peek/shared-types && \
    mkdir -p node_modules/@peek/shared-types && \
    cp -R /app/shared/package.json /app/shared/dist node_modules/@peek/shared-types/

# ===========================
# Stage 3: Production Runtime
# ===========================
FROM node:22-slim AS production

# Install runtime dependencies (cached with BuildKit)
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        nginx \
        sqlite3 \
        ca-certificates \
        curl \
    && rm -f /etc/nginx/sites-enabled/default

# App user, created as 99:100 (unRAID nobody:users, the PUID/PGID defaults).
# docker/entrypoint.sh remaps it when PUID/PGID differ.
RUN userdel --remove node \
    && groupadd --non-unique --gid 100 peek \
    && useradd --system --uid 99 --gid 100 --home-dir /home/peek --create-home --shell /usr/sbin/nologin peek

WORKDIR /app

# Copy package file
COPY server/package.json ./

# Copy pruned node_modules from build stage (already has prisma client generated)
COPY --from=backend-build /app/server/node_modules ./node_modules

# Copy Prisma schema and migrations (for runtime migrations)
COPY server/prisma/schema.prisma ./prisma/
COPY server/prisma/migrations ./prisma/migrations

# Copy built backend from build stage
COPY --from=backend-build /app/server/dist ./backend/

# Copy built frontend from build stage
COPY --from=frontend-build /app/client/dist ./frontend/

# nginx main config, entrypoint (root: maps the user, starts nginx) and start script (app user)
COPY docker/nginx.conf /etc/nginx/nginx.conf
COPY --chmod=0755 docker/entrypoint.sh docker/start.sh /app/

# Check the nginx config, then create the data directory owned by the app user
RUN mkdir -p /tmp/nginx && nginx -t -e stderr -g "user peek peek;" && rm -rf /tmp/nginx \
    && mkdir -p /app/data/tmp && chown -R peek:peek /app/data

# Expose port 80
EXPOSE 80

# Set environment variables. CHECKPOINT_DISABLE stops the Prisma CLI's update
# check from writing to $HOME/.cache.
ENV DATABASE_URL="file:/app/data/peek-stash-browser.db" \
    NODE_ENV="production" \
    NODE_OPTIONS="--max-old-space-size=2048" \
    PUID=99 \
    PGID=100 \
    CHECKPOINT_DISABLE=1 \
    NPM_CONFIG_UPDATE_NOTIFIER=false

# Health check: proves Node answers through nginx (no database query)
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -fsS --max-time 8 http://127.0.0.1/api/health > /dev/null || exit 1

# Create volumes for persistence
VOLUME ["/app/data"]

# No USER line: the entrypoint needs root to map PUID/PGID and start nginx,
# then runs start.sh as the app user
ENTRYPOINT ["/app/entrypoint.sh"]
CMD ["/app/start.sh"]

# Last, so a new date invalidates no earlier layer
ARG BUILD_DATE
ENV BUILD_DATE=${BUILD_DATE}
