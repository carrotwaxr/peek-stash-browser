# ============================================================================
# PEEK STASH BROWSER - ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this file to .env and configure for your environment
# ============================================================================

# ----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# ----------------------------------------------------------------------------
# SQLite database path, for the development stack (docker compose). The path is
# inside the container: /app/data is the PEEK_DATA_DIR bind mount below, so the
# file is ./.peek-data/peek-stash-browser.db on your machine.
# The production image ignores this variable and always uses
# /app/data/peek-stash-browser.db.
# Running the server natively: use a path on your machine, such as file:./dev.db
DATABASE_URL=file:/app/data/peek-stash-browser.db

# ----------------------------------------------------------------------------
# JWT CONFIGURATION
# ----------------------------------------------------------------------------
# Optional: Peek generates one in CONFIG_DIR when unset
# JWT_SECRET=

# ----------------------------------------------------------------------------
# PROXY AUTH CONFIGURATION
# ----------------------------------------------------------------------------
# Allow your reverse proxy to handle authentication by providing a header to
# all proxied requests with the user's username. Falls back to token-based auth
# when disabled or no header value is present.
# PROXY_AUTH_HEADER=X-Peek-Username
# Addresses allowed to send that header: comma-separated IPs and CIDR ranges
# of your proxy as Peek sees it. Unset honours the header from any address,
# with a startup warning.
# PROXY_AUTH_TRUSTED_IPS=172.18.0.5

# ----------------------------------------------------------------------------
# STASH SERVER CONFIGURATION (optional)
# ----------------------------------------------------------------------------
# A shortcut for the first start: when the database has no Stash instance and
# both variables are set, Peek creates one from them. Otherwise leave them
# unset and connect Stash in the setup wizard. They are read only while no
# instance exists; later changes belong in Settings.
# URL to your Stash GraphQL endpoint
# STASH_URL=http://your-stash-server:9999/graphql

# API key from Stash Settings > Security > API Key
# STASH_API_KEY=your_stash_api_key_here

# ----------------------------------------------------------------------------
# PEEK DATA DIRECTORY
# ----------------------------------------------------------------------------
# Where Peek keeps its database, backups and download files on YOUR system.
# This directory will be created if it doesn't exist
#
# Development (default): Uses ./.peek-data in the project directory
# Production (unRAID): Use something like /mnt/user/appdata/peek
PEEK_DATA_DIR=./.peek-data

# ----------------------------------------------------------------------------
# OPTIONAL: REVERSE PROXY / TRUST PROXY
# ----------------------------------------------------------------------------
# The number of reverse proxies (SWAG, Nginx Proxy Manager, Traefik, Caddy)
# between browsers and Peek. Peek always trusts the nginx inside its own
# image, so leave this unset when browsers reach the container directly.
# With one reverse proxy in front, set 1; with a CDN plus a proxy, set 2.
# Never set it higher than the real count: extra hops let anyone fake their
# address and dodge sign-in lockouts and rate limits.
# TRUST_PROXY=1

# ----------------------------------------------------------------------------
# OPTIONAL: PORT CONFIGURATION
# ----------------------------------------------------------------------------
# Customize the ports if you have conflicts
# Defaults: Frontend=6969, Backend=8000
# PEEK_FRONTEND_PORT=6969
# PEEK_BACKEND_PORT=8000
