# Patterns match from the context root. Only those written with **/ match at
# every depth; bare names (plugins, docs, site, e2e ...) stay root-only, so
# client/src/components/video-player/plugins/ still reaches the build.

# Secrets and user data
**/.env
**/.env.*
.peek-data
**/*.db
**/*.db-*
**/*.db.*

# Repository, tooling and local environments
.git
.gitignore
.github
.claude
.worktrees
.venv

# Documentation and site build
site
docs
**/*.md

# Root-level test, report and plugin directories
e2e
playwright-report
test-results
screenshots
plugins

# Dependencies (installed fresh in the image) and build outputs
**/node_modules
**/dist
**/.next
**/build
**/coverage
**/*.log
**/tsconfig.tsbuildinfo

# Test files (not needed for the production build)
**/tests
**/integration
**/__tests__
**/*.test.ts
**/*.test.js
**/*.spec.ts
**/*.spec.js

# IDE and editor files
.vscode
.idea
**/*.swp
**/*.swo

# OS files
**/.DS_Store
**/Thumbs.db
