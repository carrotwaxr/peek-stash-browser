{
  "options": [
    {
      "type": "section-header",
      "label": "Common Filters",
      "key": "section-common",
      "collapsible": true,
      "defaultOpen": true
    },
    {
      "key": "name",
      "label": "Name Search",
      "type": "text",
      "defaultValue": "",
      "placeholder": "Search name...",
      "maxLength": 500
    },
    {
      "key": "synopsis",
      "label": "Synopsis Search",
      "type": "text",
      "defaultValue": "",
      "placeholder": "Search synopsis...",
      "maxLength": 500
    },
    {
      "key": "director",
      "label": "Director Search",
      "type": "text",
      "defaultValue": "",
      "placeholder": "Search director...",
      "maxLength": 500
    },
    {
      "key": "performerIds",
      "label": "Performers",
      "type": "searchable-select",
      "entityType": "performers",
      "multi": true,
      "defaultValue": [],
      "placeholder": "Select performers...",
      "modifierOptions": [
        {
          "value": "INCLUDES_ALL",
          "label": "Has ALL of these"
        },
        {
          "value": "INCLUDES",
          "label": "Has ANY of these"
        },
        {
          "value": "EXCLUDES",
          "label": "Has NONE of these"
        }
      ],
      "modifierKey": "performerIdsModifier",
      "defaultModifier": "INCLUDES",
      "countFilterContext": "groups",
      "excludeKey": "performerIdsExclude"
    },
    {
      "key": "studioId",
      "label": "Studio",
      "type": "searchable-select",
      "entityType": "studios",
      "multi": false,
      "defaultValue": "",
      "placeholder": "Select studio...",
      "modifierOptions": [
        {
          "value": "INCLUDES",
          "label": "Has ANY of these"
        },
        {
          "value": "EXCLUDES",
          "label": "Has NONE of these"
        },
        {
          "value": "IS_NULL",
          "label": "Has none"
        },
        {
          "value": "NOT_NULL",
          "label": "Has any"
        }
      ],
      "modifierKey": "studioIdModifier",
      "defaultModifier": "INCLUDES",
      "supportsHierarchy": true,
      "hierarchyKey": "studioIdDepth",
      "hierarchyLabel": "Include sub-studios",
      "countFilterContext": "groups"
    },
    {
      "key": "tagIds",
      "label": "Tags",
      "type": "searchable-select",
      "entityType": "tags",
      "multi": true,
      "defaultValue": [],
      "placeholder": "Select tags...",
      "modifierOptions": [
        {
          "value": "INCLUDES_ALL",
          "label": "Has ALL of these"
        },
        {
          "value": "INCLUDES",
          "label": "Has ANY of these"
        },
        {
          "value": "EXCLUDES",
          "label": "Has NONE of these"
        },
        {
          "value": "IS_NULL",
          "label": "Has none"
        },
        {
          "value": "NOT_NULL",
          "label": "Has any"
        }
      ],
      "modifierKey": "tagIdsModifier",
      "defaultModifier": "INCLUDES_ALL",
      "supportsHierarchy": true,
      "hierarchyKey": "tagIdsDepth",
      "hierarchyLabel": "Include sub-tags",
      "countFilterContext": "groups",
      "excludeKey": "tagIdsExclude"
    },
    {
      "key": "rating",
      "label": "Rating",
      "type": "range",
      "defaultValue": {},
      "min": 0,
      "max": 10,
      "display": {
        "divisor": 10,
        "decimals": 1
      },
      "modifierOptions": [
        {
          "value": "BETWEEN",
          "label": "Between"
        },
        {
          "value": "IS_NULL",
          "label": "Not rated"
        },
        {
          "value": "NOT_NULL",
          "label": "Rated"
        }
      ],
      "modifierKey": "ratingModifier",
      "defaultModifier": "BETWEEN"
    },
    {
      "key": "sceneCount",
      "label": "Scene Count",
      "type": "range",
      "defaultValue": {},
      "min": 0,
      "max": 1000
    },
    {
      "key": "duration",
      "label": "Duration (minutes)",
      "type": "range",
      "defaultValue": {},
      "min": 1,
      "max": 300,
      "modifierOptions": [
        {
          "value": "BETWEEN",
          "label": "Between"
        },
        {
          "value": "IS_NULL",
          "label": "Not set"
        },
        {
          "value": "NOT_NULL",
          "label": "Set"
        }
      ],
      "modifierKey": "durationModifier",
      "defaultModifier": "BETWEEN"
    },
