{
  "options": [
    {
      "type": "section-header",
      "label": "Common Filters",
      "key": "section-common",
      "collapsible": true,
      "defaultOpen": true
    },
    {
      "key": "name",
      "label": "Name Search",
      "type": "text",
      "defaultValue": "",
      "placeholder": "Search name...",
      "maxLength": 500
    },
    {
      "key": "synopsis",
      "label": "Synopsis Search",
      "type": "text",
      "defaultValue": "",
      "placeholder": "Search synopsis...",
      "maxLength": 500
    },
    {
      "key": "director",
      "label": "Director Search",
      "type": "text",
      "defaultValue": "",
      "placeholder": "Search director...",
      "maxLength": 500
    },
    {
      "key": "performerIds",
      "label": "Performers",
      "type": "searchable-select",
      "entityType": "performers",
      "multi": true,
      "defaultValue": [],
      "placeholder": "Select performers...",
      "modifierOptions": [
        {
          "value": "INCLUDES_ALL",
          "label": "Has ALL of these"
        },
        {
          "value": "INCLUDES",
          "label": "Has ANY of these"
        },
        {
          "value": "EXCLUDES",
          "label": "Has NONE of these"
        }
      ],
      "modifierKey": "performerIdsModifier",
      "defaultModifier": "INCLUDES",
      "countFilterContext": "groups"
    },
    {
      "key": "studioId",
      "label": "Studio",
      "type": "searchable-select",
      "entityType": "studios",
      "multi": false,
      "defaultValue": "",
      "placeholder": "Select studio...",
      "countFilterContext": "groups"
    },
    {
      "key": "tagIds",
      "label": "Tags",
      "type": "searchable-select",
      "entityType": "tags",
      "multi": true,
      "defaultValue": [],
      "placeholder": "Select tags...",
      "modifierOptions": [
        {
          "value": "INCLUDES_ALL",
          "label": "Has ALL of these"
        },
        {
          "value": "INCLUDES",
          "label": "Has ANY of these"
        },
        {
          "value": "EXCLUDES",
          "label": "Has NONE of these"
        }
      ],
      "modifierKey": "tagIdsModifier",
      "defaultModifier": "INCLUDES_ALL",
      "countFilterContext": "groups"
    },
    {
      "key": "rating",
      "label": "Rating (0-100)",
      "type": "range",
      "defaultValue": {},
      "min": 0,
      "max": 100,
      "modifierOptions": [
        {
          "value": "BETWEEN",
          "label": "Between"
        },
        {
          "value": "IS_NULL",
          "label": "Not rated"
        },
        {
          "value": "NOT_NULL",
          "label": "Rated"
        }
      ],
      "modifierKey": "ratingModifier",
      "defaultModifier": "BETWEEN"
    },
    {
      "key": "sceneCount",
      "label": "Scene Count",
      "type": "range",
      "defaultValue": {},
      "min": 0,
      "max": 1000
    },
    {
      "key": "duration",
      "label": "Duration (minutes)",
      "type": "range",
      "defaultValue": {},
      "min": 1,
      "max": 300,
      "modifierOptions": [
        {
          "value": "BETWEEN",
          "label": "Between"
        },
        {
          "value": "IS_NULL",
          "label": "Not set"
        },
        {
          "value": "NOT_NULL",
          "label": "Set"
        }
      ],
      "modifierKey": "durationModifier",
      "defaultModifier": "BETWEEN"
    },
    {
      "key": "favorite",
      "label": "Favorite Collections",
      "type": "checkbox",
      "defaultValue": false,
      "placeholder": "Favorites Only"
    },
    {
      "type": "section-header",
      "label": "Date Ranges",
