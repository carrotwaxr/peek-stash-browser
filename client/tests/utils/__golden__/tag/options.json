    },
    {
      "key": "groupIds",
      "label": "Collections",
      "type": "searchable-select",
      "entityType": "groups",
      "multi": true,
      "defaultValue": [],
      "placeholder": "Select collections..."
    },
    {
      "key": "parentIds",
      "label": "Parent Tags",
      "type": "searchable-select",
      "entityType": "tags",
      "multi": true,
      "defaultValue": [],
      "placeholder": "Select tags...",
      "modifierOptions": [
        {
          "value": "INCLUDES_ALL",
          "label": "Has ALL of these"
        },
        {
          "value": "INCLUDES",
          "label": "Has ANY of these"
        },
        {
          "value": "EXCLUDES",
          "label": "Has NONE of these"
        }
      ],
      "modifierKey": "parentIdsModifier",
      "defaultModifier": "INCLUDES",
      "supportsHierarchy": true,
      "hierarchyKey": "parentIdsDepth",
      "hierarchyLabel": "Include sub-tags"
    },
    {
      "key": "childIds",
