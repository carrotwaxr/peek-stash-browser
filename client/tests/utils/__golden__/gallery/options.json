      "countFilterContext": "galleries",
      "excludeKey": "tagIdsExclude"
    },
    {
      "key": "rating",
      "label": "Rating",
      "type": "range",
      "defaultValue": {},
      "min": 0,
      "max": 10,
      "display": {
        "divisor": 10,
        "decimals": 1
      },
      "modifierOptions": [
        {
          "value": "BETWEEN",
          "label": "Between"
