{
  "options": [
    {
      "type": "section-header",
      "label": "Common Filters",
      "key": "section-common",
      "collapsible": true,
      "defaultOpen": true
    },
    {
      "key": "title",
      "label": "Title Search",
      "type": "text",
      "defaultValue": "",
      "placeholder": "Search title...",
      "maxLength": 500
    },
    {
      "key": "performerIds",
      "label": "Performers",
      "type": "searchable-select",
      "entityType": "performers",
      "multi": true,
      "defaultValue": [],
      "placeholder": "Select performers...",
      "modifierOptions": [
        {
          "value": "INCLUDES_ALL",
          "label": "Has ALL of these"
        },
        {
          "value": "INCLUDES",
          "label": "Has ANY of these"
        },
        {
          "value": "EXCLUDES",
          "label": "Has NONE of these"
        },
        {
          "value": "IS_NULL",
          "label": "Has none"
        },
        {
          "value": "NOT_NULL",
          "label": "Has any"
        }
      ],
      "modifierKey": "performerIdsModifier",
      "defaultModifier": "INCLUDES",
      "countFilterContext": "galleries",
      "excludeKey": "performerIdsExclude"
    },
    {
      "key": "studioIds",
      "label": "Studios",
      "type": "searchable-select",
